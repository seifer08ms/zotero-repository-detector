# Copy this file to .env for local development.

# macOS example:
# ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/Applications/Zotero.app/Contents/MacOS/zotero
# Windows example (escape backslashes when needed by your shell):
# ZOTERO_PLUGIN_ZOTERO_BIN_PATH=C:\\Program Files\\Zotero\\zotero.exe
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/path/to/zotero

# Create a dedicated Zotero development profile and point to it here.
ZOTERO_PLUGIN_PROFILE_PATH=/path/to/zotero/profile

# Optional Zotero data directory used by the development profile.
ZOTERO_PLUGIN_DATA_DIR=
